# Server
PORT=4100
BIND_HOST=127.0.0.1

# Optional API key. When set, requests must send X-API-Key: <key>
# (or ?api_key=<key>). Empty disables auth. /api/health is always open.
API_KEY=

# Response cache (SQLite). Identical queries within the TTL are served
# from cache without touching Facebook.
CACHE_TTL_SECONDS=3600

# Upstream politeness. Requests to Facebook run one at a time with at
# least this many ms between them. Raise it if you get blocked.
MIN_REQUEST_DELAY_MS=2000
MAX_RETRIES=3
BACKOFF_BASE_MS=5000

# Scraping session (lsd token + doc_ids + datr cookie) is re-bootstrapped
# after this many seconds, or immediately when Facebook rejects it.
SESSION_TTL_SECONDS=1800

# Default country for searches when ?country= is omitted (ISO 3166-1 alpha-2).
DEFAULT_COUNTRY=US

# Optional upstream proxy, e.g. http://user:pass@host:port
HTTPS_PROXY=

# Optional User-Agent override for requests to Facebook.
USER_AGENT=

# Where the SQLite cache lives.
DATA_DIR=./data
