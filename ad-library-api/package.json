{
  "name": "ad-library-api",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Meta Ad Library scraper API — query public ads as clean JSON",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:ui": "npm --prefix web test",
    "build:ui": "npm --prefix web run build",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "undici": "^8.7.0"
  }
}
