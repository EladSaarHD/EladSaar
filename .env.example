# ---- Local WellyBox configuration ----
# Copy to `.env` and adjust. The `.env` file is gitignored — never commit real secrets.

# HTTP server
PORT=4000

# Where receipts + the SQLite database are stored (relative to repo root or absolute)
DATA_DIR=./data

# Extractor: codex | tesseract | manual
# - codex     : shell out to the Codex CLI for AI extraction (default)
# - tesseract : offline OCR only (requires the optional tesseract.js dependency)
# - manual    : store files only; you type the fields yourself
EXTRACTOR=codex

# Codex CLI invocation. {image} and {prompt} are substituted at runtime.
# Confirm the exact flags for your Codex version with `codex exec --help`.
# You can override the whole command/args in config.local.json instead.
CODEX_COMMAND=codex
CODEX_ARGS=exec --image {image} {prompt}

# Watched folder — any receipt dropped here is auto-imported. Leave empty to disable.
WATCH_DIR=

# ---- Email inbox (IMAP) — optional. Leave IMAP_HOST empty to disable. ----
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
# Use an app-specific password, not your main account password.
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Only import attachments from emails whose sender/subject match (comma-separated, optional)
IMAP_FILTER_SUBJECT=receipt,invoice,order
IMAP_POLL_SECONDS=300
