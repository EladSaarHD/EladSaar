# ---- TradeView configuration ----
# Copy to `.env` and adjust. The `.env` file is gitignored — never commit real keys.

# HTTP server
PORT=4000

# Where the SQLite cache/watchlist DB is stored (relative to repo root or absolute)
DATA_DIR=./data

# Market-data provider. Currently supported: twelvedata
PROVIDER=twelvedata

# Free API key from https://twelvedata.com (Basic/free plan: 800 req/day, 8/min).
# Without a key the UI loads but no live data is returned.
TWELVEDATA_API_KEY=

# Optional: cap upstream requests per minute to stay under the free tier (default 8).
PROVIDER_RPM=8
